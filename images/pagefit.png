import { CommonModule } from '@angular/common';
import { Component } from '@angular/core';
import { FormControl, FormGroup, ReactiveFormsModule, Validators } from '@angular/forms';
import { MatFormFieldModule } from '@angular/material/form-field';
import { MatInputModule } from '@angular/material/input';
import {MatSnackBar } from '@angular/material/snack-bar';
import { Router } from '@angular/router';
@Component({
  selector: 'app-login',
  imports: [MatFormFieldModule,MatInputModule,ReactiveFormsModule,CommonModule],
  templateUrl: './login.html',
  styleUrl: './login.css'
})
export class Login {
  // isLogin:boolean=false
  loginForm:FormGroup

  constructor(private route:Router,private snack:MatSnackBar){
    this.loginForm=new FormGroup({
      usernameFc:new FormControl('',Validators.required),
      passwordFc:new FormControl('',Validators.required)

    })
  }

  //save loginForm
  Savelogin(){
    if(this.loginForm.valid){
      // this.isLogin=false;
      if(this.loginForm.get('usernameFc')?.value===this.loginForm.get('passwordFc')?.value){
        this.route.navigate(["/home"])
      }else{
        // alert('login failed!')
        this.snack.open('Invalid UserName Password!','Ok',{
          duration:2000
        })
      }
    }
  }
}
======login.html====
&lt;div class="container-fluid"&gt;
   
        &lt;div class="loginStyles"&gt;
        &lt;form [formGroup]="loginForm" class="container-fluid"&gt;
           &lt;h1 class="heading"&gt;Login Form&lt;/h1&gt;
          &lt;div class="col-6"&gt;
            &lt;mat-form-field appearance="outline"&gt;
                &lt;mat-label&gt;UserName&lt;/mat-label&gt;
                &lt;input type="text" matInput placeholder="Enter UserName" formControlName="usernameFc"&gt;
                &lt;mat-error *ngIf="loginForm.get('usernameFc')?.hasError('required') &amp;&amp; loginForm.get('usernameFc')?.touched"&gt;
                    UserName is Required
                  &lt;/mat-error&gt;
            &lt;/mat-form-field&gt;
        &lt;/div&gt;&lt;br&gt;
        &lt;div class="col-6"&gt;
            &lt;mat-form-field appearance="outline"&gt;
                &lt;mat-label&gt;Password&lt;/mat-label&gt;
                &lt;input type="password" matInput placeholder="Enter Password" formControlName="passwordFc"&gt;
                &lt;mat-error *ngIf="loginForm.get('passwordFc')?.hasError('required') &amp;&amp; loginForm.get('passwordFc')?.touched"&gt;
                    Password is Required
                  &lt;/mat-error&gt;
            &lt;/mat-form-field&gt;
        &lt;/div&gt;
        &lt;button class="btn btn-primary ms-auto d-block" (click)="Savelogin()" [disabled]="!loginForm.valid"&gt;Login&lt;/button&gt;
     &lt;/form&gt;
&lt;/div&gt;
 
&lt;/div&gt;
========home.ts=======
import { Component, Inject, PLATFORM_ID } from '@angular/core';
import { isPlatformBrowser, CommonModule } from '@angular/common';
import { AgGridModule } from 'ag-grid-angular';
import { ClientSideRowModelModule, ColDef, ModuleRegistry } from 'ag-grid-community';
import { MatDatepickerModule } from '@angular/material/datepicker';
import { FormArray, FormControl, FormGroup, ReactiveFormsModule, Validators } from '@angular/forms';
import { MatRadioModule } from '@angular/material/radio';
import { MatInputModule } from '@angular/material/input';
import { MatFormFieldModule } from '@angular/material/form-field';
import { Empservice } from '../../Service/empservice';
import { MatDialog } from '@angular/material/dialog';
import { Nominee } from '../nominee/nominee';
import { Address, EmpModel } from '../../../EmployeeModel';
import { provideNativeDateAdapter } from '@angular/material/core';

ModuleRegistry.registerModules([ClientSideRowModelModule]);

@Component({
  selector: 'app-home',
  standalone: true,
  imports: [CommonModule, AgGridModule,MatFormFieldModule,MatInputModule,ReactiveFormsModule,CommonModule,MatRadioModule,MatDatepickerModule],
  providers:[provideNativeDateAdapter()],
  templateUrl: './home.html',
  styleUrls: ['./home.css']
})
export class Home {
  columnDefs: ColDef[] = [];
  rowData: any;
  isBrowser: boolean;
  patientForm:FormGroup
  constructor(@Inject(PLATFORM_ID) platformId: Object,public dialog: MatDialog,private ser:Empservice) {
    this.isBrowser = isPlatformBrowser(platformId);
    this.patientForm=new FormGroup({
      fnameFc:new FormControl('',Validators.required),
      lnameFc:new FormControl(''),
      middleNameFc:new FormControl(''),
      dobFc:new FormControl(''),
      genderFc:new FormControl(''),
      nomineeFc:new FormControl('no'),
      formArrayFc:new FormArray([this.createNewAddress()])
    })
  }

  ngOnInit() {
    if (this.isBrowser) {
      this.getAggrid();
      // this.columnDefs = [
      //   { field: 'make', tooltipField: 'make' },
      //   { field: 'model', tooltipField: 'model' },
      //   { field: 'price', tooltipField: 'price' }
      // ];
      // this.rowData = [
      //   { make: 'Toyota', model: 'Celica', price: 35000 },
      //   { make: 'Ford', model: 'Mondeo', price: 32000 },
      //   { make: 'Porsche', model: 'Boxster', price: 72000 }
      // ];
    }
    this.getAllEmp();
  }

  getAggrid(){
    this.columnDefs=[
      {field:'empFirstNameDb',headerName:"FirstName"},
      {field:'empLastNameDb',headerName:'LastName'},
      {field:'empMiddleNameDb',headerName:'MiddleName'},
      {field:'empSalDb',headerName:'Salary'},
      {field:'genderDb',headerName:'Gender'},
      {field:'hobbiesDb',headerName:'Hobbies',
        cellRenderer:(params)=&gt;{
          // return Array.isArray(params.value) ? params.value.join(', ') : params.value;
          return params.value? params.value.join(', '):params.value
        }
      },
      { 
        field: '', 
        headerName: 'Edit',
        cellRenderer: (params) =&gt; {
          const icon = document.createElement('i');
          icon.className = 'fa fa-pencil';  // Font Awesome pencil icon
          icon.style.cursor = 'pointer';
          icon.style.color = 'black';
          return icon;
        },
        onCellClicked: (params) =&gt; {
         this.editMethod(params.data)         
        }
      },
      {
        field: '',
        headerName: 'Delete',
        cellRenderer: () =&gt; {
          const icon = document.createElement('span');
          icon.className = 'material-icons';  // or 'fa fa-trash' if you use Font Awesome
          icon.style.cursor = 'pointer';
          icon.style.color = 'red';
          icon.innerText = 'delete'; // material delete icon
          return icon;
        },
        onCellClicked: (params) =&gt; {
          this.deleteMethod(params.data.id);  // pass row data to delete method
        }
      }
      
      

    ]
  }
  editMethod(params){
    this.patientForm.patchValue({
      fnameFc:params?.empFirstNameDb,
      lnameFc:params?.empLastNameDb,
      middleNameFc:params?.empMiddleNameDb,
      dobFc:params?.empDob,
      
    })
  }
  deleteMethod(id: number) {
    if (confirm('Are you sure you want to delete this employee?')) {
      this.ser.deleteEmp(id).subscribe({
        next: (res) =&gt; {
          console.log('Deleted successfully', res);
          this.getAllEmp(); // refresh grid
        },
        error: (err) =&gt; {
          console.error('Delete failed', err);
        }
      });
    }
  }
  
   get formArrayFc():FormArray{
      return this.patientForm.get('formArrayFc') as FormArray;
    }
    onNomineeChange(event:any){
      if(event?.value === 'yes'){
        this.dialog.open(Nominee,{
          height:'400px',
          width:'500px'
        })
      }else{
        console.log('no nominiee')
      }
    }
    addAddressBtn(){
      this.formArrayFc.push(this.createNewAddress())
    }
    removeAddressBtn(i){
    this.formArrayFc.removeAt(i)
    }
    createNewAddress():FormGroup{
  return new FormGroup({
    address1Fc:new FormControl(''),
    cityFc:new FormControl(''),
    stateFc:new FormControl('')
  })
    }
   
  getAllEmp(){
    this.ser.getEmployee().subscribe({
      next:(res)=&gt;{
          // console.log(res,'getAllEmployees') 
          this.rowData = Array.isArray(res) ? res : [res];
          console.log(this.rowData,'rowData')
      },error(err) {
        
      },
    })
   } 
   savePatient(){
    let patientObj=new EmpModel();
    patientObj.empFirstNameDb=this.patientForm.get('fnameFc')?.value
    patientObj.empLastNameDb=this.patientForm.get('lnameFc')?.value
    patientObj.empMiddleNameDb=this.patientForm.get('middleNameFc')?.value
    patientObj.empDob=this.patientForm.get('dobFc')?.value
    patientObj.genderDb=this.patientForm.get('genderFc')?.value
    patientObj.addressesDb=this.addressMethod();
    this.ser.saveEmployee(patientObj).subscribe({
      next:(res)=&gt;{
        // this.rowData=res
        this.getAllEmp();

        console.log(res,'saveResult')
      },error(err) {
        
      },
    })
    this.patientForm.reset();
   }
   addressMethod():any{
    const emptyArray:Address[]=[];
    
    let formArray=this.patientForm?.get('formArrayFc')?.value ?? [];
    formArray.forEach((ele,index)=&gt;{
      const addressObj=new Address();
      addressObj.address1=ele?.address1Fc
      addressObj.city=ele?.cityFc
      addressObj.state=ele?.stateFc
      emptyArray.push(addressObj);
    })
   return emptyArray;
   
   }
}

======home.html======
&lt;div class="container-fluid card w-50 pt-2 mt-5"&gt;

  &lt;form [formGroup]="patientForm"&gt;
    &lt;h2 class="text-center text-success fw-bold my-4"&gt;Registration Form&lt;/h2&gt;
    &lt;div class="row col-12"&gt;

      &lt;!-- First Name --&gt;
      &lt;div class="col-4"&gt;
        &lt;mat-form-field appearance="outline"&gt;
          &lt;mat-label&gt;FirstName&lt;/mat-label&gt;
          &lt;input type="text" matInput placeholder="FirstName" formControlName="fnameFc"&gt;
          &lt;mat-error *ngIf="patientForm.get('fnameFc')?.hasError('required') &amp;&amp; patientForm.get('fnameFc')?.touched"&gt;
            FirstName is Required
          &lt;/mat-error&gt;
        &lt;/mat-form-field&gt;
      &lt;/div&gt;

      &lt;!-- Last Name --&gt;
      &lt;div class="col-4"&gt;
        &lt;mat-form-field appearance="outline"&gt;
          &lt;mat-label&gt;LastName&lt;/mat-label&gt;
          &lt;input type="text" matInput placeholder="LastName" formControlName="lnameFc"&gt;
        &lt;/mat-form-field&gt;
      &lt;/div&gt;
    &lt;/div&gt;
    &lt;div class="row col-12"&gt;
      &lt;!-- Middle Name --&gt;
      &lt;div class="col-4"&gt;
        &lt;mat-form-field appearance="outline"&gt;
          &lt;mat-label&gt;MiddleName&lt;/mat-label&gt;
          &lt;input type="text" matInput placeholder="MiddleName" formControlName="middleNameFc"&gt;
        &lt;/mat-form-field&gt;
      &lt;/div&gt;

      &lt;!-- Date of Birth (DOB) --&gt;
      &lt;div class="col-4"&gt;
        &lt;mat-form-field appearance="outline"&gt;
          &lt;mat-label&gt;Dob&lt;/mat-label&gt;
          &lt;input matInput [matDatepicker]="picker" formControlName="dobFc"&gt;
          &lt;mat-hint&gt;MM/DD/YYYY&lt;/mat-hint&gt;
          &lt;mat-datepicker-toggle matIconSuffix [for]="picker"&gt;&lt;/mat-datepicker-toggle&gt;
          &lt;mat-datepicker #picker&gt;&lt;/mat-datepicker&gt;
        &lt;/mat-form-field&gt;
      &lt;/div&gt;

    &lt;/div&gt;

    &lt;!-- Second Row: Gender, Nominee, etc. --&gt;
    &lt;div class="row mt-3 col-12"&gt;
      &lt;!-- Gender --&gt;
      &lt;div class="col-6"&gt;
        &lt;mat-radio-group aria-label="Select Gender" formControlName="genderFc"&gt;
          &lt;mat-label&gt;Gender:&lt;/mat-label&gt;
          &lt;mat-radio-button value="male"&gt;Male&lt;/mat-radio-button&gt;
          &lt;mat-radio-button value="female"&gt;Female&lt;/mat-radio-button&gt;
        &lt;/mat-radio-group&gt;
      &lt;/div&gt;

      &lt;!-- Nominee --&gt;
      &lt;div class="col-6"&gt;
        &lt;mat-radio-group aria-label="Select Nominee" formControlName="nomineeFc" (change)="onNomineeChange($event)"&gt;
          &lt;mat-label&gt;Nominee:&lt;/mat-label&gt;
          &lt;mat-radio-button value="yes"&gt;Yes&lt;/mat-radio-button&gt;
          &lt;mat-radio-button value="no"&gt;No&lt;/mat-radio-button&gt;
        &lt;/mat-radio-group&gt;
      &lt;/div&gt;

      &lt;!-- Address Form Array --&gt;
      &lt;!-- Address Form Array --&gt;
      &lt;div class="col-12" formArrayName="formArrayFc"&gt;
        &lt;div *ngFor="let item of formArrayFc.controls; let i = index" [formGroupName]="i"
          class="row align-items-end mb-2"&gt;

          &lt;!-- Address 1 --&gt;
          &lt;div class="col-3"&gt;
            &lt;mat-form-field appearance="outline" class="w-100"&gt;
              &lt;mat-label&gt;Address1&lt;/mat-label&gt;
              &lt;input type="text" matInput placeholder="Address1" formControlName="address1Fc"&gt;
            &lt;/mat-form-field&gt;
          &lt;/div&gt;

          &lt;!-- City --&gt;
          &lt;div class="col-3"&gt;
            &lt;mat-form-field appearance="outline" class="w-100"&gt;
              &lt;mat-label&gt;City&lt;/mat-label&gt;
              &lt;input type="text" matInput placeholder="City" formControlName="cityFc"&gt;
            &lt;/mat-form-field&gt;
          &lt;/div&gt;

          &lt;!-- State --&gt;
          &lt;div class="col-3"&gt;
            &lt;mat-form-field appearance="outline" class="w-100"&gt;
              &lt;mat-label&gt;State&lt;/mat-label&gt;
              &lt;input type="text" matInput placeholder="State" formControlName="stateFc"&gt;
            &lt;/mat-form-field&gt;
          &lt;/div&gt;

          &lt;!-- Buttons --&gt;
          &lt;div class="col-3 mb-4 d-flex gap-2"&gt;
            &lt;!-- Add (+) --&gt;
            &lt;button type="button" class="btn btn-success" (click)="addAddressBtn()"&gt;+&lt;/button&gt;

            &lt;!-- Delete (x) --&gt;
            &lt;button type="button" class="btn btn-danger" (click)="removeAddressBtn(i)"
              *ngIf="formArrayFc.length &gt; 1"&gt;×&lt;/button&gt;
          &lt;/div&gt;
        &lt;/div&gt;
        &lt;button class="btn btn-primary ms-auto d-block mb-2" (click)="savePatient()" [disabled]="!patientForm.valid" &gt;Save&lt;/button&gt;
      &lt;/div&gt;
 
    &lt;/div&gt;
  &lt;/form&gt;
&lt;/div&gt;



&lt;ng-container *ngIf="isBrowser"&gt;
    &lt;ag-grid-angular
      class="ag-theme-alpine"
      style="width: 100%; height: 400px;"
      [rowData]="rowData"
      [columnDefs]="columnDefs"&gt;
    &lt;/ag-grid-angular&gt;
  &lt;/ng-container&gt;
