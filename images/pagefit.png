import { Component, OnInit } from '@angular/core';
 import { AgGridModule } from 'ag-grid-angular';
        import { ColDef } from 'ag-grid-community';
@Component({
  selector: 'app-home',
   standalone: true,
  imports: [AgGridModule],
  templateUrl: './home.html',
  styleUrls: ['./home.css']
})
export class Home implements OnInit{

    columnDef: ColDef[] = [];
    gridData(){
      this.columnDef = [
    { headerName: 'Make', field: 'make', sortable: true, filter: true },
    { headerName: 'Model', field: 'model', sortable: true, filter: true },
    { headerName: 'Price', field: 'price', sortable: true, filter: true }
  ];
    }
    ngOnInit(): void {
      this.gridData();
    }

   // Row Data
  rowData = [
    { make: 'Toyota', model: 'Corolla', price: 35000 },
    { make: 'Ford', model: 'Mustang', price: 55000 },
    { make: 'Tesla', model: 'Model 3', price: 45000 },
    { make: 'BMW', model: 'M3', price: 65000 },
    { make: 'Audi', model: 'A4', price: 40000 },
    { make: 'Honda', model: 'Civic', price: 22000 },
    { make: 'Chevrolet', model: 'Camaro', price: 55000 },
    { make: 'Mercedes', model: 'E-Class', price: 70000 },
    { make: 'Hyundai', model: 'Elantra', price: 23000 },
    { make: 'Nissan', model: 'Altima', price: 25000 }
  ];
}
