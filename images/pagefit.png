	--Add-physician.component.ts--
import { MatSelectSearchComponent } from '@shared/components/mat-select-search/mat-select-search.component';
import { FilterPipe } from '@shared/pipes/filter.pipe';
imports:[MatSelectSearchComponent,FilterPipe]
	   searchWord = {    //this part is correct or not once conform
      jobtitle: '',
    // departmentCode: '',
    // diagnosisConfirmation: ''
  };
   onCloseEvent(select){
  select.close()
}
 ==html===
&lt;mat-form-field class='example-full-width' appearance='outline'&gt;
	&lt;mat-label&gt;Departments&lt;/mat-label&gt;
	&lt;mat-select  formControlName="departmentCodeFC"  placeholder="Department"  #deptRef&gt;
	   &lt;app-mat-select-search (searchChange)="searchWord['departmentCodeFC'] = $event" (closeEvent)="onCloseEvent(deptRef)"&gt;&lt;/app-mat-select-search&gt; 
	&lt;mat-option *ngFor="let dept of departments | filter: searchWord['departmentCodeFC']  : ['departmentName']" [value]="dept.departmentCode"&gt;
			{{dept.departmentName}}
		&lt;/mat-option&gt;
	&lt;/mat-select&gt;			</div></div></div></div></div></div></div><span class="sr-only"><br></span></section><section class="text-token-text-primary w-full focus:outline-none [--shadow-height:45px] has-data-writing-block:pointer-events-none has-data-writing-block:-mt-(--shadow-height) has-data-writing-block:pt-(--shadow-height) [&amp;:has([data-writing-block])&gt;*]:pointer-events-auto scroll-mt-(--header-height)" dir="auto" data-turn-id="e626da6e-f52b-43b2-b47c-f74713829775" data-testid="conversation-turn-39" data-scroll-anchor="false" data-turn="user"><h4 class="sr-only select-none">You said:</h4><div class="text-base my-auto mx-auto [--thread-content-margin:var(--thread-content-margin-xs,calc(var(--spacing)*4))] @w-sm/main:[--thread-content-margin:var(--thread-content-margin-sm,calc(var(--spacing)*6))] @w-lg/main:[--thread-content-margin:var(--thread-content-margin-lg,calc(var(--spacing)*16))] px-(--thread-content-margin)"><div class="[--thread-content-max-width:40rem] @w-lg/main:[--thread-content-max-width:48rem] mx-auto max-w-(--thread-content-max-width) flex-1 group/turn-messages focus-visible:outline-hidden relative flex w-full min-w-0 flex-col"><div class="flex max-w-full flex-col gap-4 grow"><div data-message-author-role="user" data-message-id="e626da6e-f52b-43b2-b47c-f74713829775" dir="auto" class="min-h-8 text-message relative flex w-full flex-col items-end gap-2 text-start break-words whitespace-normal outline-none keyboard-focused:focus-ring [.text-message+&amp;]:mt-1"><div class="flex w-full flex-col gap-1 empty:hidden items-end rtl:items-start"><div class="user-message-bubble-color corner-superellipse/0.98 relative rounded-[22px] px-4 py-2.5 leading-6 max-w-(--user-chat-width,70%)"><div class="whitespace-pre-wrap">ii) ctrl+delete to delete left side content:
 ctrl+ backspace to delete right side content 

&lt;mat-form-field appearance="outline" class="example-full-width"&gt;
                &lt;mat-label&gt;Patient Type&lt;/mat-label&gt;
                &lt;mat-select formControlName="patientType" [disableOptionCentering]="true" multiple #selectPatientType&gt;
                   &lt;mat-select-trigger 
                    appMatSelectTriggerDisplay
                    [items]="patientTypedata"
                    [selectedIds]="patientReportForm.get('patientType')?.value"
                    idKey="mnemonic"
                    displayKey="name"&gt;
                &lt;/mat-select-trigger&gt;
                 &lt;div class="sticky-search"&gt;
                &lt;app-mat-select-search (searchChange)="searchPatientType($event)" 
                  (closeEvent)="onCloseEvent(selectPatientType)"  &gt;
                &lt;/app-mat-select-search&gt;
              &lt;/div&gt; 
               &lt;mat-option #allPatientTypeRef
                  [disabled]="patientTypedata?.length === 0"
                  [value]="0"(click)="toggleAllPatientTypeStatus(allPatientTypeRef)"
                 &gt;All&lt;/mat-option&gt; 

                   @for (item of patientTypedata; track item) {   
                  &lt;mat-option 
                  [value]="item.mnemonic"
                  (click)="tosslePerOneSelectedPatientStatus(allPatientTypeRef)"
                  [appHideBySearch]="searchPatientTypeWord"
                  [searchField]="'name'"
                  [optionData]="item"&gt;
                  {{item.name}} &lt;/mat-option&gt;
                  }
                     &lt;!-- &lt;mat-option *ngFor="let item of patientTypedata" [value]="item.mnemonic"&gt;
                                {{item.name}} &lt;/mat-option&gt; --&gt;
                &lt;/mat-select&gt;
              &lt;/mat-form-field&gt;
 searchPatientTypeWord:string;
  searchPatientType(event){
    if(typeof(event)==='string')
    this.searchPatientTypeWord = event;
  }
   toggleAllPatientTypeStatus(allPatientTypeRef: MatOption) {
    const patientTypeControl = this.patientReportForm.get('patientType');
    if (allPatientTypeRef.selected) {
      patientTypeControl.patchValue([...this.patientTypedata.map(item =&gt; item.mnemonic), 0]);
    } else {
      // patientTypeControl.patchValue([]);
        const visibleItems = this.getVisiblePatientStation();
    const visibleMnemonics = visibleItems.map(i =&gt; i.mnemonic);

    const currentSelected = patientTypeControl.value || [];

    // Remove only the visible items
    const updated = currentSelected.filter(v =&gt; !visibleMnemonics.includes(v));

    patientTypeControl.patchValue(updated);
    }
  }
  getVisiblePatientStation() {
  const search = this.searchPatientTypeWord?.toLowerCase() || '';
  return this.patientTypedata.filter(item =&gt;
    item.name.toLowerCase().includes(search)
  );
}
 tosslePerOneSelectedPatientStatus(allPatientTypeRef: MatOption) {
    if (allPatientTypeRef.selected) {
      allPatientTypeRef.deselect();
      return false;
    }
    if (this.patientReportForm.get('patientType').value.length == this.patientTypedata.length) {
      allPatientTypeRef.select();
    }
  }	
			  
