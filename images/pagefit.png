  _store=inject(Store); // import store 
  editEmployee$:Observable&lt;any&gt;=this._store.select(EmpStateClass.getEmpEditData)
  
 ngOnInit(): void {
   this.editEmployee$.subscribe((employee) =&gt; {
    if (employee) {
      console.log(employee,'employee data')
       this.patchForm(employee); // here we are calling patchMethod and patching that data see below method
    }
  });
 } 
 patchForm(data){
  this.empForm.patchValue({
    firstNameFc:data?.firstName,
    lastNameFc:data?.lastName,
    dobFc:data?.dob,
    genderFc:data?.gender,
    salaryFc:data?.salary,
    designationFc:data?.designation
  })
