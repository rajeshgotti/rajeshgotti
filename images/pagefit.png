  getDeceases(event) {
    if (this.ccForm.value?.diagnosis.length &gt; 2) {
      this.problems= [];
     if (this.ccForm.value.codeType == 'IC') {
         this.bindLabel = "longDesc"  //  e result lo manam longDesc di cupistunam and down lo manaki veredi cupiyali so akkada manam bind label "term" ani icham
       this.erDashboardService.getICDData(this.ccForm.value?.diagnosis, this.ccForm.value?.isStrict).pipe(takeUntil(this.onDestroy$),debounceTime(500)).subscribe(res =&gt; {
         this.problems = res.body;
       })
     } else if (this.ccForm.value?.codeType == 'SM') {
      this.bindLabel = "term"   // bindlabel="term" so here res?.body lo vacinda anni recoreds lo vuna term ni html dropdown lo cupistunam
       this.codesService.getSnomedcodesV1(this.ccForm.value?.diagnosis).pipe(takeUntil(this.onDestroy$)).subscribe(res =&gt; {
         this.problems = res.body;
       })
