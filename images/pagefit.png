                &lt;ng-template #signatureDialog&gt;
                  &lt;div class="modalHeader clearfix "&gt;     
                    &lt;div class="modal-about"&gt;
                        &lt;div class="font-weight-bold p-t-5 p-l-10"&gt;
                            Add Signature
                        &lt;/div&gt;
                    &lt;/div&gt; 
                    &lt;div class="closeIcon"&gt;
                    &lt;button mat-icon-button (click)="closeSignature()" aria-label="Close dialog" data-mat-icon-type="font"&gt;
                        &lt;mat-icon&gt;close&lt;/mat-icon&gt;
                    &lt;/button&gt;
                    &lt;/div&gt;
                  &lt;/div&gt;
                   &lt;mat-dialog-content&gt;
                     &lt;mat-form-field appearance="outline" class="w-100"&gt;
                      &lt;mat-label&gt;Signature Text&lt;/mat-label&gt;
                      &lt;input matInput [(ngModel)]="signatureText"&gt;
                     &lt;/mat-form-field&gt;
                   &lt;/mat-dialog-content&gt;
                &lt;mat-dialog-actions align="end"&gt;
                    &lt;button type="reset" mat-raised-button color="accent" (click)="closeSignature()"&gt;Cancel&lt;/button&gt;
                    &lt;button mat-raised-button color="primary" (click)="saveSignature()" [disabled]="!signatureText?.trim()"&gt;Save&lt;/button&gt;
                &lt;/mat-dialog-actions&gt;
                &lt;/ng-template&gt;
               }

@ViewChild('signatureDialog') signatureDialog!: TemplateRef&lt;any&gt;;
signatureText = '';

signatureDialogRef!: MatDialogRef&lt;any&gt;;
signatureClick() {
  this.signatureDialogRef=this.dialog.open(this.signatureDialog, { width: '400px' });
}
closeSignature(){
  this.signatureDialogRef.close();
}
saveSignature() {
  this.dialog.closeAll();
}

}</div></div></div></div></div></div></div><span class="sr-only"><br></span></section><section class="text-token-text-primary w-full focus:outline-none [--shadow-height:45px] has-data-writing-block:pointer-events-none has-data-writing-block:-mt-(--shadow-height) has-data-writing-block:pt-(--shadow-height) [&amp;:has([data-writing-block])&gt;*]:pointer-events-auto scroll-mt-(--header-height)" dir="auto" data-turn-id="54998b4d-b7d7-49fc-a403-6a8d757fcd20" data-testid="conversation-turn-57" data-scroll-anchor="false" data-turn="user"><h4 class="sr-only select-none">You said:</h4><div class="text-base my-auto mx-auto [--thread-content-margin:var(--thread-content-margin-xs,calc(var(--spacing)*4))] @w-sm/main:[--thread-content-margin:var(--thread-content-margin-sm,calc(var(--spacing)*6))] @w-lg/main:[--thread-content-margin:var(--thread-content-margin-lg,calc(var(--spacing)*16))] px-(--thread-content-margin)"><div class="[--thread-content-max-width:40rem] @w-lg/main:[--thread-content-max-width:48rem] mx-auto max-w-(--thread-content-max-width) flex-1 group/turn-messages focus-visible:outline-hidden relative flex w-full min-w-0 flex-col"><div class="flex max-w-full flex-col gap-4 grow"><div data-message-author-role="user" data-message-id="54998b4d-b7d7-49fc-a403-6a8d757fcd20" dir="auto" class="min-h-8 text-message relative flex w-full flex-col items-end gap-2 text-start break-words whitespace-normal outline-none keyboard-focused:focus-ring [.text-message+&amp;]:mt-1"><div class="flex w-full flex-col gap-1 empty:hidden items-end rtl:items-start"><div class="user-message-bubble-color corner-superellipse/0.98 relative rounded-[22px] px-4 py-2.5 leading-6 max-w-(--user-chat-width,70%)"><div class="whitespace-pre-wrap">in mkdocs if i heighlted one word then all the words in that file shold be heiglighted hwo to make it </div></div></div></div></div><div class="z-0 flex justify-end"><div aria-label="Your message actions" class="touch:-me-2 touch:-ms-3.5 -ms-2.5 -me-1 flex flex-wrap items-center gap-y-4 p-1 select-none focus-within:transition-none hover:transition-none touch:pointer-events-auto touch:opacity-100 duration-300 group-hover/turn-messages:delay-300 pointer-events-none opacity-0 motion-safe:transition-opacity group-hover/turn-messages:pointer-events-auto group-hover/turn-messages:opacity-100 group-focus-within/turn-messages:pointer-events-auto group-focus-within/turn-messages:opacity-100 has-data-[state=open]:pointer-events-auto has-data-[state=open]:opacity-100" role="group" tabindex="-1" style="mask-position: 0% 0%;"><button class="text-token-text-secondary hover:bg-token-bg-secondary rounded-lg" aria-label="Copy message" data-testid="copy-turn-action-button" data-state="closed"><span class="flex items-center justify-center touch:w-10 h-8 w-8"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" aria-hidden="true" class="icon"><use href="/cdn/assets/sprites-core-dd80ba6x.svg#ce3544" fill="currentColor"></use></svg></span></button><button class="text-token-text-secondary hover:bg-token-bg-secondary rounded-lg" aria-label="Edit message" data-state="closed"><span class="flex items-center justify-center touch:w-10 h-8 w-8"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" aria-hidden="true" class="icon"><use href="/cdn/assets/sprites-core-dd80ba6x.svg#6d87e1" fill="currentColor"></use></svg></span></button></div></div></div></div><span class="sr-only"><br></span></section><section class="text-token-text-primary w-full focus:outline-none [--shadow-height:45px] has-data-writing-block:pointer-events-none has-data-writing-block:-mt-(--shadow-height) has-data-writing-block:pt-(--shadow-height) [&amp;:has([data-writing-block])&gt;*]:pointer-events-auto scroll-mt-[calc(var(--header-height)+min(200px,max(70px,20svh)))]" dir="auto" data-turn-id="5f5c0ea0-237a-47b2-868a-0bf2e863c276" data-testid="conversation-turn-58" data-scroll-anchor="false" data-turn="assistant"><h4 class="sr-only select-none">ChatGPT said:</h4><div class="text-base my-auto mx-auto [--thread-content-margin:var(--thread-content-margin-xs,calc(var(--spacing)*4))] @w-sm/main:[--thread-content-margin:var(--thread-content-margin-sm,calc(var(--spacing)*6))] @w-lg/main:[--thread-content-margin:var(--thread-content-margin-lg,calc(var(--spacing)*16))] px-(--thread-content-margin)"><div class="[--thread-content-max-width:40rem] @w-lg/main:[--thread-content-max-width:48rem] mx-auto max-w-(--thread-content-max-width) flex-1 group/turn-messages focus-visible:outline-hidden relative flex w-full min-w-0 flex-col agent-turn"><div class="flex max-w-full flex-col gap-4 grow"><div data-message-author-role="assistant" data-message-id="6fab948d-07cf-47a0-bcdd-3f68b2a4a621" dir="auto" data-message-model-slug="gpt-5-2" class="min-h-8 text-message relative flex w-full flex-col items-end gap-2 text-start break-words whitespace-normal outline-none keyboard-focused:focus-ring [.text-message+&amp;]:mt-1"><div class="flex w-full flex-col gap-1 empty:hidden"><div class="markdown prose dark:prose-invert w-full wrap-break-word light markdown-new-styling"><p data-start="0" data-end="49">Good question — and an <strong data-start="23" data-end="48">important distinction</strong>:</p>
<h3 data-section-id="ocgg2b" data-start="51" data-end="71">🔍 What you want</h3>
<blockquote data-start="72" data-end="193">
<p data-start="74" data-end="193"><em data-start="74" data-end="193">“When I highlight one word in a page, every occurrence of that word in the file should also highlight automatically.”</em></p>
</blockquote>
<p data-start="195" data-end="354">👉 <strong data-start="198" data-end="274">MkDocs (even MkDocs-Material) does NOT support “select-to-highlight all”</strong>.<br data-start="275" data-end="278">
Browsers don’t do that either — selection highlights only the text you drag.</p>
<p data-start="356" data-end="460">But you <em data-start="364" data-end="369">can</em> get something very close — and in most cases <strong data-start="415" data-end="425">better</strong> — using features already built in.</p>
<hr data-start="462" data-end="465">
<h2 data-section-id="16oxavo" data-start="467" data-end="533">✅ Option 1 — Use MkDocs-Material search highlight (recommended)</h2>
<p data-start="535" data-end="619">When you search instead of selecting, <strong data-start="573" data-end="618">all matches get highlighted automatically</strong>.</p>
<p data-start="621" data-end="651">Add this to your <code data-start="638" data-end="650">mkdocs.yml</code>:</p>
<pre class="overflow-visible! px-0!" data-start="653" data-end="727"><div class="relative w-full mt-4 mb-1"><div class=""><div class="relative"><div class="h-full min-h-0 min-w-0"><div class="h-full min-h-0 min-w-0" style="width: 100%; transform: none;"><div class="border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl"><div class="h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback"><div class="sticky z-2 select-none top-(--sticky-padding-top)"><div class="flex w-full items-center justify-between py-1.5 ps-4 pe-1.5 font-sans md:ps-5 bg-token-bg-elevated-secondary"><div class="flex max-w-[75%] min-w-0 cursor-default items-center text-sm font-medium justify-self-start text-token-text-primary"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" aria-hidden="true" class="icon-sm me-2.5 shrink-0"><use href="/cdn/assets/sprites-core-dd80ba6x.svg#e45ab3" fill="currentColor"></use></svg>YAML</div><div class="flex flex-row items-center gap-0.5 justify-self-end"><button class="flex gap-1 items-center select-none py-2 text-sm font-medium hover:bg-black/5 dark:hover:bg-white/10 size-9 rounded-full px-2" aria-label="Copy" data-state="closed"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" aria-hidden="true" class="icon-md"><use href="/cdn/assets/sprites-core-dd80ba6x.svg#ce3544" fill="currentColor"></use></svg></button></div></div></div><div class="pointer-events-none absolute inset-x-4 top-12 bottom-4"><div class="pointer-events-none sticky z-40 shrink-0 z-1!" style="top: calc(calc(var(--sticky-padding-top) + 48px) - 1px * 3); margin-bottom: calc(-4px); height: calc(4px); mask-image: linear-gradient(transparent 25%, white 75%);"><div class="sticky bg-token-border-light" style="top: calc(var(--sticky-padding-top) + 48px); height: 1px;"></div></div></div><div class="w-full overflow-x-hidden overflow-y-auto" style="transform: none; max-height: 433px;"><div class="relative z-0 flex max-w-full"><div id="code-block-viewer" dir="ltr" class="q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼ5 ͼj"><div class="cm-scroller"><div class="cm-content q9tKkq_readonly"><span>theme:</span><br><span>  features:</span><br><span>    - search.highlight</span><br><span>    - search.suggest</span></div></div></div></div></div></div></div></div></div><div class=""><div class="" style="width: 100%; transform: none;"></div></div></div></div></div></pre>
<p data-start="729" data-end="734">Then:</p>
<p data-start="736" data-end="859">1️⃣ Press <strong data-start="746" data-end="758">Ctrl + K</strong> (or click the search bar)<br data-start="784" data-end="787">
2️⃣ Type the word<br data-start="804" data-end="807">
3️⃣ All occurrences get highlighted across the page.</p>
<p data-start="861" data-end="919">This is the usual way people do “highlight all” in MkDocs.</p>
<hr data-start="921" data-end="924">
<h2 data-section-id="19fzrh3" data-start="926" data-end="992">⚙️ Option 2 — Force highlight on text-selection (custom script)</h2>
<p data-start="994" data-end="1058">If you <em data-start="1001" data-end="1009">really</em> want:<br data-start="1015" data-end="1018">
➡️ “click/select → highlight everywhere”</p>
<p data-start="1060" data-end="1095">You must add <strong data-start="1073" data-end="1094">custom JavaScript</strong>.</p>
<p data-start="1097" data-end="1108">Add a file:</p>
<p data-start="1110" data-end="1146"><code data-start="1110" data-end="1146">docs/assets/highlight-selection.js</code></p>
<pre class="overflow-visible! px-0!" data-start="1148" data-end="2033"><div class="relative w-full mt-4 mb-1"><div class=""><div class="relative"><div class="h-full min-h-0 min-w-0"><div class="h-full min-h-0 min-w-0" style="width: 100%; transform: none;"><div class="border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl"><div class="h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback"><div class="sticky z-2 select-none top-(--sticky-padding-top)"><div class="flex w-full items-center justify-between py-1.5 ps-4 pe-1.5 font-sans md:ps-5 bg-token-bg-elevated-secondary"><div class="flex max-w-[75%] min-w-0 cursor-default items-center text-sm font-medium justify-self-start text-token-text-primary"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" aria-hidden="true" class="icon-sm me-2.5 shrink-0"><use href="/cdn/assets/sprites-core-dd80ba6x.svg#e45ab3" fill="currentColor"></use></svg>JavaScript</div><div class="flex flex-row items-center gap-0.5 justify-self-end"><button class="flex gap-1 items-center select-none py-2 text-sm font-medium hover:bg-black/5 dark:hover:bg-white/10 size-9 rounded-full px-2" aria-label="Copy" data-state="closed"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" aria-hidden="true" class="icon-md"><use href="/cdn/assets/sprites-core-dd80ba6x.svg#ce3544" fill="currentColor"></use></svg></button></div></div></div><div class="pointer-events-none absolute inset-x-4 top-12 bottom-4"><div class="pointer-events-none sticky z-40 shrink-0 z-1!" style="top: calc(calc(var(--sticky-padding-top) + 48px) - 1px * 3); margin-bottom: calc(-4px); height: calc(4px); mask-image: linear-gradient(transparent 25%, white 75%);"><div class="sticky bg-token-border-light" style="top: calc(var(--sticky-padding-top) + 48px); height: 1px;"></div></div></div><div class="w-full overflow-x-hidden overflow-y-auto" style="transform: none; max-height: 433px;"><div class="relative z-0 flex max-w-full"><div id="code-block-viewer" dir="ltr" class="q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼ5 ͼj"><div class="cm-scroller"><div class="cm-content q9tKkq_readonly"><span class="ͼe">document</span><span class="ͼ8">.</span><span>addEventListener(</span><span class="ͼc">"mouseup"</span><span>, </span><span class="ͼ8">function</span><span> () {</span><br><span>  </span><span class="ͼ8">const</span><span> </span><span class="ͼe">text</span><span> </span><span class="ͼ8">=</span><span> </span><span class="ͼe">window</span><span class="ͼ8">.</span><span>getSelection()</span><span class="ͼ8">.</span><span>toString()</span><span class="ͼ8">.</span><span>trim();</span><br><span>  </span><span class="ͼ8">if</span><span> (</span><span class="ͼ8">!</span><span class="ͼe">text</span><span> </span><span class="ͼ8">||</span><span> </span><span class="ͼe">text</span><span class="ͼ8">.</span><span>length </span><span class="ͼ8">&lt;</span><span> </span><span class="ͼb">2</span><span>) </span><span class="ͼ8">return</span><span>;</span><br><br><span>  </span><span class="ͼ6">// remove old highlights</span><br><span>  </span><span class="ͼe">document</span><span class="ͼ8">.</span><span>querySelectorAll(</span><span class="ͼc">".custom-highlight"</span><span>)</span><span class="ͼ8">.</span><span>forEach(</span><span class="ͼe">el</span><span> =&gt; {</span><br><span>    </span><span class="ͼe">el</span><span class="ͼ8">.</span><span>outerHTML </span><span class="ͼ8">=</span><span> </span><span class="ͼe">el</span><span class="ͼ8">.</span><span>innerText;</span><br><span>  });</span><br><br><span>  </span><span class="ͼ8">const</span><span> </span><span class="ͼe">regex</span><span> </span><span class="ͼ8">=</span><span> </span><span class="ͼ8">new</span><span> </span><span class="ͼe">RegExp</span><span>(</span><span class="ͼe">text</span><span>, </span><span class="ͼc">"gi"</span><span>);</span><br><span>  </span><span class="ͼ8">const</span><span> </span><span class="ͼe">walker</span><span> </span><span class="ͼ8">=</span><span> </span><span class="ͼe">document</span><span class="ͼ8">.</span><span>createTreeWalker(</span><br><span>    </span><span class="ͼe">document</span><span class="ͼ8">.</span><span>body,</span><br><span>    </span><span class="ͼe">NodeFilter</span><span class="ͼ8">.</span><span>SHOW_TEXT,</span><br><span>    </span><span class="ͼb">null</span><span>,</span><br><span>    </span><span class="ͼb">false</span><br><span>  );</span><br><br><span>  </span><span class="ͼ8">let</span><span> </span><span class="ͼe">node</span><span>;</span><br><span>  </span><span class="ͼ8">while</span><span> ((</span><span class="ͼe">node</span><span> </span><span class="ͼ8">=</span><span> </span><span class="ͼe">walker</span><span class="ͼ8">.</span><span>nextNode())) {</span><br><span>    </span><span class="ͼ8">if</span><span> (</span><span class="ͼe">node</span><span class="ͼ8">.</span><span>parentNode</span><span class="ͼ8">.</span><span>classList?.contains(</span><span class="ͼc">"custom-highlight"</span><span>)) </span><span class="ͼ8">continue</span><span>;</span><br><span>    </span><span class="ͼ8">const</span><span> </span><span class="ͼe">replaced</span><span> </span><span class="ͼ8">=</span><span> </span><span class="ͼe">node</span><span class="ͼ8">.</span><span>nodeValue</span><span class="ͼ8">.</span><span>replace(</span><span class="ͼe">regex</span><span>, </span><span class="ͼe">match</span><span> =&gt;</span><br><span>      </span><span class="ͼc">`&lt;span class="custom-highlight"&gt;</span><span>${</span><span class="ͼe">match</span><span>}</span><span class="ͼc">&lt;/span&gt;`</span><br><span>    );</span><br><span>    </span><span class="ͼ8">if</span><span> (</span><span class="ͼe">replaced</span><span> </span><span class="ͼ8">!==</span><span> </span><span class="ͼe">node</span><span class="ͼ8">.</span><span>nodeValue) {</span><br><span>      </span><span class="ͼ8">const</span><span> </span><span class="ͼe">span</span><span> </span><span class="ͼ8">=</span><span> </span><span class="ͼe">document</span><span class="ͼ8">.</span><span>createElement(</span><span class="ͼc">"span"</span><span>);</span><br><span>      </span><span class="ͼe">span</span><span class="ͼ8">.</span><span>innerHTML </span><span class="ͼ8">=</span><span> </span><span class="ͼe">replaced</span><span>;</span><br><span>      </span><span class="ͼe">node</span><span class="ͼ8">.</span><span>parentNode</span><span class="ͼ8">.</span><span>replaceChild(</span><span class="ͼe">span</span><span>, </span><span class="ͼe">node</span><span>);</span><br><span>    }</span><br><span>  }</span><br><span>});</span></div></div></div></div></div></div></div></div></div><div class=""><div class="" style="width: 100%; transform: none;"></div></div></div></div></div></pre>
<p data-start="2035" data-end="2046">Add styles:</p>
<p data-start="2048" data-end="2075"><code data-start="2048" data-end="2075">docs/assets/highlight.css</code></p>
<pre class="overflow-visible! px-0!" data-start="2077" data-end="2149"><div class="relative w-full mt-4 mb-1"><div class=""><div class="relative"><div class="h-full min-h-0 min-w-0"><div class="h-full min-h-0 min-w-0" style="width: 100%; transform: none;"><div class="border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl"><div class="h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback"><div class="sticky z-2 select-none top-(--sticky-padding-top)"><div class="flex w-full items-center justify-between py-1.5 ps-4 pe-1.5 font-sans md:ps-5 bg-token-bg-elevated-secondary"><div class="flex max-w-[75%] min-w-0 cursor-default items-center text-sm font-medium justify-self-start text-token-text-primary"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" aria-hidden="true" class="icon-sm me-2.5 shrink-0"><use href="/cdn/assets/sprites-core-dd80ba6x.svg#e45ab3" fill="currentColor"></use></svg>CSS</div><div class="flex flex-row items-center gap-0.5 justify-self-end"><button class="flex gap-1 items-center select-none py-2 text-sm font-medium hover:bg-black/5 dark:hover:bg-white/10 size-9 rounded-full px-2" aria-label="Copy" data-state="closed"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" aria-hidden="true" class="icon-md"><use href="/cdn/assets/sprites-core-dd80ba6x.svg#ce3544" fill="currentColor"></use></svg></button></div></div></div><div class="pointer-events-none absolute inset-x-4 top-12 bottom-4"><div class="pointer-events-none sticky z-40 shrink-0 z-1!" style="top: calc(calc(var(--sticky-padding-top) + 48px) - 1px * 3); margin-bottom: calc(-4px); height: calc(4px); mask-image: linear-gradient(transparent 25%, white 75%);"><div class="sticky bg-token-border-light" style="top: calc(var(--sticky-padding-top) + 48px); height: 1px;"></div></div></div><div class="w-full overflow-x-hidden overflow-y-auto" style="transform: none; max-height: 433px;"><div class="relative z-0 flex max-w-full"><div id="code-block-viewer" dir="ltr" class="q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼ5 ͼj"><div class="cm-scroller"><div class="cm-content q9tKkq_readonly"><span>.</span><span class="ͼd">custom-highlight</span><span> {</span><br><span>  background: </span><span class="ͼb">yellow</span><span>;</span><br><span>  padding: </span><span class="ͼb">0</span><span> </span><span class="ͼb">2</span><span class="ͼ8">px</span><span>;</span><br><span>}</span></div></div></div></div></div></div></div></div></div><div class=""><div class="" style="width: 100%; transform: none;"></div></div></div></div></div></pre>
<p data-start="2151" data-end="2180">Include them in <code data-start="2167" data-end="2179">mkdocs.yml</code>:</p>
<pre class="overflow-visible! px-0!" data-start="2182" data-end="2282"><div class="relative w-full mt-4 mb-1"><div class=""><div class="relative"><div class="h-full min-h-0 min-w-0"><div class="h-full min-h-0 min-w-0" style="width: 100%; transform: none;"><div class="border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl"><div class="h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback"><div class="sticky z-2 select-none top-(--sticky-padding-top)"><div class="flex w-full items-center justify-between py-1.5 ps-4 pe-1.5 font-sans md:ps-5 bg-token-bg-elevated-secondary"><div class="flex max-w-[75%] min-w-0 cursor-default items-center text-sm font-medium justify-self-start text-token-text-primary"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" aria-hidden="true" class="icon-sm me-2.5 shrink-0"><use href="/cdn/assets/sprites-core-dd80ba6x.svg#e45ab3" fill="currentColor"></use></svg>YAML</div><div class="flex flex-row items-center gap-0.5 justify-self-end"><button class="flex gap-1 items-center select-none py-2 text-sm font-medium hover:bg-black/5 dark:hover:bg-white/10 size-9 rounded-full px-2" aria-label="Copy" data-state="closed"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" aria-hidden="true" class="icon-md"><use href="/cdn/assets/sprites-core-dd80ba6x.svg#ce3544" fill="currentColor"></use></svg></button></div></div></div><div class="pointer-events-none absolute inset-x-4 top-12 bottom-4"><div class="pointer-events-none sticky z-40 shrink-0 z-1!" style="top: calc(calc(var(--sticky-padding-top) + 48px) - 1px * 3); margin-bottom: calc(-4px); height: calc(4px); mask-image: linear-gradient(transparent 25%, white 75%);"><div class="sticky bg-token-border-light" style="top: calc(var(--sticky-padding-top) + 48px); height: 1px;"></div></div></div><div class="w-full overflow-x-hidden overflow-y-auto" style="transform: none; max-height: 433px;"><div class="relative z-0 flex max-w-full"><div id="code-block-viewer" dir="ltr" class="q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼ5 ͼj"><div class="cm-scroller"><div class="cm-content q9tKkq_readonly"><span>extra_javascript:</span><br><span>  - assets/highlight-selection.js</span><br><br><span>extra_css:</span><br><span>  - assets/highlight.css</span></div></div></div></div></div></div></div></div></div><div class=""><div class="" style="width: 100%; transform: none;"></div></div></div></div></div></pre>
<p data-start="2284" data-end="2338">➡️ Now, <strong data-start="2292" data-end="2337">select a word → every instance highlights</strong>.</p>
<hr data-start="2340" data-end="2343">
<h2 data-section-id="1wffd4e" data-start="2345" data-end="2364">🎯 My suggestion</h2>
<p data-start="2366" data-end="2431">If your goal is <strong data-start="2382" data-end="2407">learning notes / docs</strong>, the cleanest workflow:</p>
<p data-start="2433" data-end="2541">✔ press <strong data-start="2441" data-end="2453">Ctrl + K</strong> (site search)<br data-start="2467" data-end="2470">
✔ type the word<br data-start="2485" data-end="2488">
✔ everything highlights — no custom code to maintain.</p>
<p data-start="2543" data-end="2617">Use the custom script only if you <em data-start="2577" data-end="2585">really</em> need select-based highlighting.</p>
<hr data-start="2619" data-end="2622">
<p data-start="2624" data-end="2714" data-is-last-node="" data-is-only-node="">If you want, send me your <code data-start="2650" data-end="2662">mkdocs.yml</code>, and I’ll integrate the best option for your setup.</p></div></div></div></div><div class="z-0 flex min-h-[46px] justify-start"><div aria-label="Response actions" class="touch:-me-2 touch:-ms-3.5 -ms-2.5 -me-1 flex flex-wrap items-center gap-y-4 p-1 select-none touch:w-[calc(100%+--spacing(3.5))] -mt-1 w-[calc(100%+--spacing(2.5))] duration-[1.5s] focus-within:transition-none hover:transition-none touch:pointer-events-auto pointer-events-none [mask-image:linear-gradient(to_right,black_33%,transparent_66%)] [mask-size:300%_100%] [mask-position:100%_0%] motion-safe:transition-[mask-position] group-hover/turn-messages:pointer-events-auto group-hover/turn-messages:[mask-position:0_0] group-focus-within/turn-messages:pointer-events-auto group-focus-within/turn-messages:[mask-position:0_0] has-data-[state=open]:pointer-events-auto has-data-[state=open]:[mask-position:0_0]" role="group" tabindex="-1" style="mask-position: 0% 0%;"><button class="text-token-text-secondary hover:bg-token-bg-secondary rounded-lg" aria-label="Copy response" data-testid="copy-turn-action-button" data-state="closed"><span class="flex items-center justify-center touch:w-10 h-8 w-8"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" aria-hidden="true" class="icon"><use href="/cdn/assets/sprites-core-dd80ba6x.svg#ce3544" fill="currentColor"></use></svg></span></button><button class="text-token-text-secondary hover:bg-token-bg-secondary rounded-lg" aria-label="Good response" aria-pressed="false" data-testid="good-response-turn-action-button" data-state="closed"><span class="flex items-center justify-center touch:w-10 h-8 w-8"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" aria-hidden="true" class="icon"><use href="/cdn/assets/sprites-core-dd80ba6x.svg#51753c" fill="currentColor"></use></svg></span></button><button class="text-token-text-secondary hover:bg-token-bg-secondary rounded-lg" aria-label="Bad response" aria-pressed="false" data-testid="bad-response-turn-action-button" data-state="closed"><span class="flex items-center justify-center touch:w-10 h-8 w-8"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" aria-hidden="true" class="icon"><use href="/cdn/assets/sprites-core-dd80ba6x.svg#2126ae" fill="currentColor"></use></svg></span></button><button class="text-token-text-secondary hover:bg-token-bg-secondary rounded-lg" aria-label="Share" data-state="closed"><span class="flex items-center justify-center touch:w-10 h-8 w-8"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" aria-hidden="true" class="icon"><use href="/cdn/assets/sprites-core-dd80ba6x.svg#630ca2" fill="currentColor"></use></svg></span></button><span class="" data-state="closed"><button type="button" id="radix-_r_vp_" aria-haspopup="menu" aria-expanded="false" data-state="closed" class="cursor-pointer touch:px-2.5 text-token-text-secondary hover:bg-token-bg-secondary h-[30px] rounded-md px-1.5" aria-label="Switch model"><div class="flex items-center"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" aria-hidden="true" class="icon"><use href="/cdn/assets/sprites-core-dd80ba6x.svg#ec66f0" fill="currentColor"></use></svg></div></button></span><button class="text-token-text-secondary hover:bg-token-bg-secondary touch:w-10 flex h-8 w-8 items-center justify-center rounded-lg" aria-label="More actions" type="button" id="radix-_r_vs_" aria-haspopup="menu" aria-expanded="false" data-state="closed"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" aria-hidden="true" class="icon"><use href="/cdn/assets/sprites-core-dd80ba6x.svg#f6d0e2" fill="currentColor"></use></svg></button></div></div></div></div><span class="sr-only"><br></span></section><section class="text-token-text-primary w-full focus:outline-none [--shadow-height:45px] has-data-writing-block:pointer-events-none has-data-writing-block:-mt-(--shadow-height) has-data-writing-block:pt-(--shadow-height) [&amp;:has([data-writing-block])&gt;*]:pointer-events-auto scroll-mt-(--header-height)" dir="auto" data-turn-id="ee640181-7a73-452b-b871-805b644a1bcc" data-testid="conversation-turn-59" data-scroll-anchor="false" data-turn="user"><h4 class="sr-only select-none">You said:</h4><div class="text-base my-auto mx-auto pt-12 [--thread-content-margin:var(--thread-content-margin-xs,calc(var(--spacing)*4))] @w-sm/main:[--thread-content-margin:var(--thread-content-margin-sm,calc(var(--spacing)*6))] @w-lg/main:[--thread-content-margin:var(--thread-content-margin-lg,calc(var(--spacing)*16))] px-(--thread-content-margin)"><div class="[--thread-content-max-width:40rem] @w-lg/main:[--thread-content-max-width:48rem] mx-auto max-w-(--thread-content-max-width) flex-1 group/turn-messages focus-visible:outline-hidden relative flex w-full min-w-0 flex-col"><div class="flex max-w-full flex-col gap-4 grow"><div data-message-author-role="user" data-message-id="ee640181-7a73-452b-b871-805b644a1bcc" dir="auto" class="min-h-8 text-message relative flex w-full flex-col items-end gap-2 text-start break-words whitespace-normal outline-none keyboard-focused:focus-ring [.text-message+&amp;]:mt-1"><div class="flex w-full flex-col gap-1 empty:hidden items-end rtl:items-start"><div class="user-message-bubble-color corner-superellipse/0.98 relative rounded-[22px] px-4 py-2.5 leading-6 max-w-(--user-chat-width,70%)"><div class="whitespace-pre-wrap">after selecting word without pressing ctrl+f i wnat like when word is seleected then automatically it is should heighlighted not after presing ctrl+f</div></div></div></div></div><div class="z-0 flex justify-end"><div aria-label="Your message actions" class="touch:-me-2 touch:-ms-3.5 -ms-2.5 -me-1 flex flex-wrap items-center gap-y-4 p-1 select-none focus-within:transition-none hover:transition-none touch:pointer-events-auto touch:opacity-100 duration-300 group-hover/t