	export class ViewClinicComponent implements OnInit{
 @ViewChild('agGrid') agGrid: AgGridAngular;
 tooltipShowDelay = 0;
  rowHeight: number = 30;
  agHeaderHeight: number = 32;
  page;
   sideBar: SideBarDef = {
    toolPanels: ['columns', 'filters', {
      id: 'settings',
      labelDefault: 'Settings',
      labelKey: 'filters',
      iconKey: 'custom-icon',
      toolPanel: CustomToolpanelComponent,
      minWidth: 180,
      maxWidth: 400,
      // width: 250,
    },],
    position: 'right',
    defaultToolPanel: 'none',
    hiddenByDefault: false,
  };
    defaultColDef = {
    resizable: true,
    sortable: true,
    filter: true,
    flex: 1,
  };

clinicColumnDefs=[]
constructor(private homeService:HomeService){}
ngOnInit(): void {
  this.getClinciData();
  this.clinicolumnDefs();
}
ClinicRecords:[]
getClinciData():void{
  this.homeService.getClinicData().subscribe({
    next:(res)=&gt;{
      console.log(res,'clinicData');
      this.ClinicRecords=res.body;
    }
  })
}
clinicolumnDefs(){
 this.clinicColumnDefs=[
   { field: 'clinicId', minWidth: 50, headerName: 'C_Id', headerTooltip: "Clinic Id", tooltipField: 'Clinic Id', enableRowGroup: true, enableValue: true },
  //  { field:'clinicId',minWidth: 50,headerName:'Clinic Id',headerTooltip:'CLinic Tooltip',tooltipField: 'Clinic Id',enableRowGroup: true, enableValue: true},
      { field: 'clinicName', minWidth: 200, headerName: 'Clinic Name', headerTooltip: "Clinic Name", tooltipField: 'Clinic Name', enableRowGroup: true, enableValue: true },
      { field: 'firstName', minWidth: 100, headerName: 'First Name', headerTooltip: 'First Name', tooltipField: 'First Name', enableRowGroup: true, enableValue: true },
   
 ]
}
}
    &lt;section&gt;
    &lt;mat-sidenav-container&gt;
        &lt;mat-sidenav #sidenav [mode]="'over'" position="end"&gt;
            &lt;div&gt;
                &lt;h1&gt;Clinci Information&lt;/h1&gt;
                &lt;button class="m-auto" (click)="close(sidenav)"&gt;Close&lt;/button&gt;
            &lt;/div&gt;
            &lt;div class="sidenavWidth"&gt;
                &lt;app-clinic-create&gt;&lt;/app-clinic-create&gt;
            &lt;/div&gt;
        &lt;/mat-sidenav&gt;
        &lt;mat-sidenav-content&gt; main
            &lt;div&gt;
                &lt;span class="extra_features" (click)="addClinic(sidenav)"&gt;&lt;button&gt;+Clinic&lt;/button&gt;&lt;/span&gt;
            &lt;/div&gt;
            &lt;div&gt;
                &lt;div class="col-lg-12 col-xl-12 col-md-12 col-sm-12 col-12 ag_wrap_control"&gt;
                    &lt;ag-grid-angular id="myGrid"
                        class="ag-theme-material ag_height-100 .ag-theme-material.ag_widthsize .ag-cell "
                        [rowData]="ClinicRecords" [columnDefs]="clinicolumnDefs" domLayout='normal' [sideBar]="sideBar"
                        [rowHeight]="rowHeight" [headerHeight]="agHeaderHeight" [defaultColDef]="defaultColDef"
                        rowSelection="multiple"&gt;
                    &lt;/ag-grid-angular&gt;
                &lt;/div&gt;
            &lt;/div&gt;
        &lt;/mat-sidenav-content&gt;
    &lt;/mat-sidenav-container&gt;
  &lt;/section&gt;
