        &lt;mat-sidenav #sidenav [mode]="'over'" position="end"&gt;
            &lt;div&gt;
                &lt;h1&gt;Clinci Information&lt;/h1&gt;
                &lt;button class="m-auto" (click)="close(sidenav)"&gt;Close&lt;/button&gt;
            &lt;/div&gt;
            &lt;div class="sidenavWidth"&gt;
                &lt;app-clinic-create&gt;&lt;/app-clinic-create&gt;
            &lt;/div&gt;
        &lt;/mat-sidenav&gt;
        &lt;mat-sidenav-content&gt; main
            &lt;div&gt;
                &lt;span class="extra_features" (click)="addClinic(sidenav)"&gt;&lt;button&gt;+Clinic&lt;/button&gt;&lt;/span&gt;
            &lt;/div&gt;
            &lt;div&gt;
                &lt;div class="col-lg-12 col-xl-12 col-md-12 col-sm-12 col-12 ag_wrap_control"&gt;
                    &lt;ag-grid-angular id="myGrid"
                        class="ag-theme-material ag_height-100 .ag-theme-material.ag_widthsize .ag-cell "
                        [rowData]="ClinicRecords" [columnDefs]="clinicolumnDefs" domLayout='normal' [sideBar]="sideBar"
                        [rowHeight]="rowHeight" [headerHeight]="agHeaderHeight" [defaultColDef]="defaultColDef"
                        rowSelection="multiple"&gt;
                    &lt;/ag-grid-angular&gt;
                &lt;/div&gt;
            &lt;/div&gt;
        &lt;/mat-sidenav-content&gt;
    &lt;/mat-sidenav-container&gt;
  &lt;/section&gt;

