<h2 data-section-id="sm835w" data-start="123" data-end="170">🖥️ VS Code / Angular Productivity Shortcuts</h2>
<h3 data-section-id="hr658f" data-start="172" data-end="193">🗑️ Line Deletion</h3>
<ul data-start="194" data-end="351">
<li data-section-id="yn4xu6" data-start="194" data-end="241">
<p data-start="196" data-end="241"><strong data-start="196" data-end="218">Delete entire line</strong> → <code data-start="221" data-end="239">Ctrl + Shift + K</code></p>
</li>
<li data-section-id="elytsw" data-start="242" data-end="295">
<p data-start="244" data-end="295"><strong data-start="244" data-end="275">Delete right side of cursor</strong> → <code data-start="278" data-end="293">Ctrl + Delete</code></p>
</li>
<li data-section-id="xgup2l" data-start="296" data-end="351">
<p data-start="298" data-end="351"><strong data-start="298" data-end="328">Delete left side of cursor</strong> → <code data-start="331" data-end="349">Ctrl + Backspace</code></p>
</li>
</ul>
