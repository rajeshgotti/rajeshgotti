  constructor(private dialog: MatDialog){}
 openDocumentDialog(): void {
  let patientData: {patientId: number; visitId: number;patientName: string;};
  if (!this.patientDataFromPatientScan?.patientId) {
    patientData = {
      patientId: this.patientId,
      visitId: this.visitId,
      patientName: this.patientName
    };
	} //End of if condition
	const dialogRef= this.dialog.open(UploadScanPatientDocumentsComponent, {
    width: '45%',
    height: '70%', //(or) 'auto'
    data: {
      data: this.patientData,
      editData: this.editData,
      DataFromWorklist:true  
    }
  });
   dialogRef.afterClosed().subscribe(result =&gt; {  //dilog close aina tarvata get CALL chestunam
      if (result === true) {
        this.getPatientCharts();
      }
    });
}	
   (or) // if u want to send 0 in dialog
   addNewFileToNewPatient():void{
    const patientData= {patientId: 0, visitId: 0,patientName: ''};
    const dialogRef= this.dialog.open(UploadScanPatientDocumentsComponent, {
    hasBackdrop: false,
    width: '45%',
    height: '75%',
    disableClose: true,
    data: {
      data: patientData,
      DataFromWorklist:true  
    }
  });
  }
  
