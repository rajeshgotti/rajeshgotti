====servicefile====
import { HttpClient } from '@angular/common/http';
import { Injectable } from '@angular/core';
import { environment } from '../Components/environment';

@Injectable({
  providedIn: 'root'
})
export class Empservice {
  constructor(private http:HttpClient){}

  // getEmployee(){
  //   return this.http.get(environment.baseUrl+environment.employeeDb)
  // }
  // saveEmployee(body){
  //   return this.http.post(environment.baseUrl+environment.employeeDb,body)
  // }
  // deleteEmp(id: number) {
  //   return this.http.delete(<code class="rounded-sm bg-(--theme-user-msg-text)/10 dark:bg-(--theme-user-msg-text)/15 px-1 py-0.5 text-(--theme-user-msg-text) text-sm">${environment.baseUrl}${environment.employeeDb}/${id}</code>);
  // }
  getEmployee() {
    return this.http.get(<code class="rounded-sm bg-(--theme-user-msg-text)/10 dark:bg-(--theme-user-msg-text)/15 px-1 py-0.5 text-(--theme-user-msg-text) text-sm">${environment.baseUrl}${environment.employeeDb}</code>);
  }
  
  saveEmployee(body: any) {
    return this.http.post(<code class="rounded-sm bg-(--theme-user-msg-text)/10 dark:bg-(--theme-user-msg-text)/15 px-1 py-0.5 text-(--theme-user-msg-text) text-sm">${environment.baseUrl}${environment.employeeDb}</code>, body);
  }
  
  deleteEmp(id: number) {
    return this.http.delete(<code class="rounded-sm bg-(--theme-user-msg-text)/10 dark:bg-(--theme-user-msg-text)/15 px-1 py-0.5 text-(--theme-user-msg-text) text-sm">${environment.baseUrl}${environment.employeeDb}/${id}</code>);
  }
  
  
}
===model====
	// Address model
	export class Address {
     address1: string;
      city: string;
      state: string;
    }
    
    // Employee model
    export class EmpModel {
      id: number;
      empFirstNameDb: string;
      empLastNameDb: string;
      empMiddleNameDb:string;
      empDob: string;
      empSalDb: string;
      genderDb: string;
      departmentDb: string;
      hobbiesDb: string[];
      addressesDb: Address[];
    }
    
    // Nominee model
    export class NomineeModel {
      firstName: string;
      lastName: string;
      gender: string;
      mobile: number;
      Relation: string;
    }
