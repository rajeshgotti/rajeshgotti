ht: 433px;"><div class="relative z-0 flex max-w-full"><div id="code-block-viewer" dir="ltr" class="q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼ5 ͼj"><div class="cm-scroller"><div class="cm-content q9tKkq_readonly"><span>.</span><span class="ͼd">custom-highlight</span><span> {</span><br><span>  background-color: </span><span class="ͼb">yellow</span><span>;</span><br><span>  color: </span><span class="ͼb">black</span><span>;</span><br><span>  padding: </span><span class="ͼb">0</span><span> </span><span class="ͼb">2</span><span class="ͼ8">px</span><span>;</span><br><span>  border-radius: </span><span class="ͼb">2</span><span class="ͼ8">px</span><span>;</span><br><span>}</span></div></div></div></div></div></div></div></div></div><div class=""><div class="" style="width: 100%; transform: none;"></div></div></div></div></div></pre>
