&lt;!-- Header: Name and X button side by side --&gt;
&lt;div class="d-flex justify-content-between align-items-center p-2 border-bottom"&gt;
    &lt;p class="m-0 fw-bold"&gt;Nominee Details&lt;/p&gt;
    &lt;button class="btn-close" aria-label="Close" (click)="close()"&gt;&lt;/button&gt;
  &lt;/div&gt;
 &lt;form [formGroup]="nominieeForm"&gt;
  &lt;!-- Form content below --&gt;
  &lt;div class="container-fluid pt-3"&gt;
    &lt;div class="row col-12"&gt;
      &lt;div class="col-6"&gt;
        &lt;mat-form-field appearance="outline"&gt;
          &lt;mat-label&gt;FirstName&lt;/mat-label&gt;
          &lt;input type="text" matInput placeholder="FirstName" formControlName="fnameFc" /&gt;
        &lt;/mat-form-field&gt;
      &lt;/div&gt;
      &lt;div class="col-6"&gt;
        &lt;mat-form-field appearance="outline"&gt;
          &lt;mat-label&gt;LastName&lt;/mat-label&gt;
          &lt;input type="text" matInput placeholder="LastName" formControlName="lnameFc" /&gt;
        &lt;/mat-form-field&gt;
      &lt;/div&gt;
    &lt;/div&gt;
    &lt;div class="row col-12"&gt;
      &lt;div class="col-6"&gt;
        &lt;mat-form-field appearance="outline"&gt;
          &lt;mat-label&gt;PhoneNumb&lt;/mat-label&gt;
          &lt;input type="number" matInput placeholder="PhoneNumber" formControlName="phoneFc" /&gt;
        &lt;/mat-form-field&gt;
      &lt;/div&gt;
      &lt;div class="col-6"&gt;
        &lt;mat-form-field appearance="outline" class="mx-2"&gt;
          &lt;mat-label&gt;Select Relation&lt;/mat-label&gt;
          &lt;mat-select formControlName="relationFc"&gt;
            &lt;mat-option *ngFor="let item of RelationData" [value]="item.id"&gt;
              {{ item.relation }}
            &lt;/mat-option&gt;
          &lt;/mat-select&gt;
        &lt;/mat-form-field&gt;
      &lt;/div&gt;
    &lt;/div&gt;
    &lt;div class="d-flex"&gt;
        &lt;button (click)="saveNaminee()" class="ms-auto d-block btn btn-primary"&gt;Save&lt;/button&gt;
      &lt;/div&gt;
      
  &lt;/div&gt;
&lt;/form&gt; 
