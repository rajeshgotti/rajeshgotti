 max-height: 433px;"><div class="relative z-0 flex max-w-full"><div id="code-block-viewer" dir="ltr" class="q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼ5 ͼj"><div class="cm-scroller"><div class="cm-content q9tKkq_readonly"><span class="ͼe">document</span><span class="ͼ8">.</span><span>addEventListener(</span><span class="ͼc">"click"</span><span>, (</span><span class="ͼe">e</span><span>) =&gt; {</span><br><span>  </span><span class="ͼ8">if</span><span> (</span><span class="ͼ8">!</span><span class="ͼe">window</span><span class="ͼ8">.</span><span>getSelection()</span><span class="ͼ8">.</span><span>toString()) {</span><br><span>    </span><span class="ͼe">document</span><span class="ͼ8">.</span><span>querySelectorAll(</span><span class="ͼc">".custom-highlight"</span><span>)</span><span class="ͼ8">.</span><span>forEach(</span><span class="ͼe">el</span><span> =&gt; {</span><br><span>      </span><span class="ͼe">el</span><span class="ͼ8">.</span><span>replaceWith(</span><span class="ͼe">document</span><span class="ͼ8">.</span><span>createTextNode(</span><span class="ͼe">el</span><span class="ͼ8">.</span><span>textContent));</span><br><span>    });</span><br><span>  }</span><br><span>});</span></div></div></div></div></div></div></div></div></div><div class=""><div class="" style="width: 100%; transform: none;"></div></div></div></div></div></pre>
