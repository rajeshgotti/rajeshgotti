      ==state.ts==
	  import { State, Selector, Action, StateContext } from '@ngxs/store';
		import { SetActionData } from './empAction';

		export interface EmpStateModel {
		  empEditData: any;
		  firstName: string;
		}

		@State&lt;EmpStateModel&gt;({
		  name: 'SetActionData',
		  defaults: {
			empEditData: null,
			firstName:null,
		  },
		})
		export class EmpStateClass {
		  @Selector()
		  static getEmpEditData(state: EmpStateModel) {
			return state.empEditData;
		  }

		  @Action(SetActionData)
		  SetActionData(ctx: StateContext&lt;EmpStateModel&gt;, action: SetActionData) {
			ctx.patchState({ empEditData: action.payload });
		  }
		}
step:2 open app.config.ts import importProvidersFrom  in providers
        providers: [ importProvidersFrom(
					NgxsModule.forRoot([
                    EmpStateClass
         ]))
