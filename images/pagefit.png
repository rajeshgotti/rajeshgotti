<h2 data-section-id="124b8gg" data-start="1200" data-end="1238">🔹 Why Bootstrap class not working?</h2>
<div class="TyagGW_tableContainer"><div tabindex="-1" class="group TyagGW_tableWrapper flex flex-col-reverse w-fit"><table data-start="1239" data-end="1430" class="w-fit min-w-(--thread-content-width)"><thead data-start="1239" data-end="1263"><tr data-start="1239" data-end="1263"><th data-start="1239" data-end="1248" data-col-size="sm" class="">Reason</th><th data-start="1248" data-end="1263" data-col-size="sm" class="">Explanation</th></tr></thead><tbody data-start="1285" data-end="1430"><tr data-start="1285" data-end="1326"><td data-start="1285" data-end="1305" data-col-size="sm"><code data-start="1287" data-end="1304">mat-icon-button</code></td><td data-start="1305" data-end="1326" data-col-size="sm">Icon-only styling</td></tr><tr data-start="1327" data-end="1373"><td data-start="1327" data-end="1342" data-col-size="sm">Material CSS</td><td data-start="1342" data-end="1373" data-col-size="sm">Overrides <code data-start="1354" data-end="1371">text-decoration</code></td></tr><tr data-start="1374" data-end="1430"><td data-start="1374" data-end="1394" data-col-size="sm">Bootstrap utility</td><td data-start="1394" data-end="1430" data-col-size="sm">Designed for <code data-start="1409" data-end="1414">&lt;a&gt;</code> / <code data-start="1417" data-end="1428">.btn-link</code></td></tr></tbody></table><div class="sticky h-0 select-none end-(--thread-content-margin) self-end"><div class="absolute end-0 flex items-end" style="height: 32.7188px;"><span class="" data-state="closed"><button aria-label="Copy table" class="hover:bg-token-bg-tertiary text-token-text-secondary my-1 rounded-sm p-1 transition-opacity group-[:not(:hover):not(:focus-within)]:pointer-events-none group-[:not(:hover):not(:focus-within)]:opacity-0"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" aria-hidden="true" class="icon"><use href="/cdn/assets/sprites-core-dd80ba6x.svg#ce3544" fill="currentColor"></use></svg></button></span></div></div></div></div>
