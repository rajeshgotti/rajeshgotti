<h2 data-section-id="uqbs3m" data-start="613" data-end="653">🔥 JS (Improved + Stable + Copy Safe)</h2>
<pre class="overflow-visible! px-0!" data-start="655" data-end="2399"><div class="relative w-full mt-4 mb-1"><div class=""><div class="relative"><div class="h-full min-h-0 min-w-0"><div class="h-full min-h-0 min-w-0" style="width: 100%; transform: none;"><div class="border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl"><div class="h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback"><div class="sticky z-2 select-none top-(--sticky-padding-top)"><div class="flex w-full items-center justify-between py-1.5 ps-4 pe-1.5 font-sans md:ps-5 bg-token-bg-elevated-secondary"><div class="flex max-w-[75%] min-w-0 cursor-default items-center text-sm font-medium justify-self-start text-token-text-primary"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" aria-hidden="true" class="icon-sm me-2.5 shrink-0"><use href="/cdn/assets/sprites-core-dd80ba6x.svg#e45ab3" fill="currentColor"></use></svg>JavaScript</div><div class="flex flex-row items-center gap-0.5 justify-self-end"><button class="flex gap-1 items-center select-none py-2 text-sm font-medium hover:bg-black/5 dark:hover:bg-white/10 size-9 rounded-full px-2" aria-label="Copy" data-state="closed"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" aria-hidden="true" class="icon-md"><use href="/cdn/assets/sprites-core-dd80ba6x.svg#ce3544" fill="currentColor"></use></svg></button></div></div></div><div class="pointer-events-none absolute inset-x-4 top-12 bottom-4"><div class="pointer-events-none sticky z-40 shrink-0 z-1!" style="top: calc(calc(var(--sticky-padding-top) + 48px) - 1px * 3); margin-bottom: calc(-4px); height: calc(4px); mask-image: linear-gradient(transparent 25%, white 75%);"><div class="sticky bg-token-border-light" style="top: calc(var(--sticky-padding-top) + 48px); height: 1px;"></div></div></div><div class="w-full overflow-x-hidden overflow-y-auto" style="transform: none; max-height: 433px;"><div class="relative z-0 flex max-w-full"><div id="code-block-viewer" dir="ltr" class="q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼ5 ͼj"><div class="cm-scroller"><div class="cm-content q9tKkq_readonly"><span class="ͼe">document</span><span class="ͼ8">.</span><span>addEventListener(</span><span class="ͼc">"mouseup"</span><span>, () =&gt; {</span><br><span>  </span><span class="ͼ8">const</span><span> </span><span class="ͼe">selection</span><span> </span><span class="ͼ8">=</span><span> </span><span class="ͼe">window</span><span class="ͼ8">.</span><span>getSelection();</span><br><span>  </span><span class="ͼ8">const</span><span> </span><span class="ͼe">selectedText</span><span> </span><span class="ͼ8">=</span><span> </span><span class="ͼe">selection</span><span class="ͼ8">.</span><span>toString()</span><span class="ͼ8">.</span><span>trim();</span><br><br><span>  </span><span class="ͼ8">if</span><span> (</span><span class="ͼ8">!</span><span class="ͼe">selectedText</span><span> </span><span class="ͼ8">||</span><span> </span><span class="ͼe">selectedText</span><span class="ͼ8">.</span><span>length </span><span class="ͼ8">&lt;</span><span> </span><span class="ͼb">2</span><span>) </span><span class="ͼ8">return</span><span>;</span><br><br><span>  </span><span class="ͼ6">// ✅ Remove old highlights safely</span><br><span>  </span><span class="ͼe">document</span><span class="ͼ8">.</span><span>querySelectorAll(</span><span class="ͼc">".custom-highlight"</span><span>)</span><span class="ͼ8">.</span><span>forEach(</span><span class="ͼe">el</span><span> =&gt; {</span><br><span>    </span><span class="ͼ8">const</span><span> </span><span class="ͼe">parent</span><span> </span><span class="ͼ8">=</span><span> </span><span class="ͼe">el</span><span class="ͼ8">.</span><span>parentNode;</span><br><span>    </span><span class="ͼe">parent</span><span class="ͼ8">.</span><span>replaceChild(</span><span class="ͼe">document</span><span class="ͼ8">.</span><span>createTextNode(</span><span class="ͼe">el</span><span class="ͼ8">.</span><span>textContent), </span><span class="ͼe">el</span><span>);</span><br><span>    </span><span class="ͼe">parent</span><span class="ͼ8">.</span><span>normalize();</span><br><span>  });</span><br><br><span>  </span><span class="ͼ6">// Escape special characters</span><br><span>  </span><span class="ͼ8">const</span><span> </span><span class="ͼe">escapedText</span><span> </span><span class="ͼ8">=</span><span> </span><span class="ͼe">selectedText</span><span class="ͼ8">.</span><span>replace(</span><span class="ͼc">/[.*+?^${}()|[\]\\]/g</span><span>, </span><span class="ͼc">"</span><span class="ͼi">\\</span><span class="ͼc">$&amp;"</span><span>);</span><br><span>  </span><span class="ͼ8">const</span><span> </span><span class="ͼe">regex</span><span> </span><span class="ͼ8">=</span><span> </span><span class="ͼ8">new</span><span> </span><span class="ͼe">RegExp</span><span>(</span><span class="ͼe">escapedText</span><span>, </span><span class="ͼc">"gi"</span><span>);</span><br><br><span>  </span><span class="ͼ8">const</span><span> </span><span class="ͼe">container</span><span> </span><span class="ͼ8">=</span><span> </span><span class="ͼe">document</span><span class="ͼ8">.</span><span>querySelector(</span><span class="ͼc">"main"</span><span>) </span><span class="ͼ8">||</span><span> </span><span class="ͼe">document</span><span class="ͼ8">.</span><span>body;</span><br><br><span>  </span><span class="ͼ8">const</span><span> </span><span class="ͼe">walker</span><span> </span><span class="ͼ8">=</span><span> </span><span class="ͼe">document</span><span class="ͼ8">.</span><span>createTreeWalker(</span><br><span>    </span><span class="ͼe">container</span><span>,</span><br><span>    </span><span class="ͼe">NodeFilter</span><span class="ͼ8">.</span><span>SHOW_TEXT</span><br><span>  );</span><br><br><span>  </span><span class="ͼ8">let</span><span> </span><span class="ͼe">node</span><span>;</span><br><br><span>  </span><span class="ͼ8">while</span><span> ((</span><span class="ͼe">node</span><span> </span><span class="ͼ8">=</span><span> </span><span class="ͼe">walker</span><span class="ͼ8">.</span><span>nextNode())) {</span><br><br><span>    </span><span class="ͼ8">const</span><span> </span><span class="ͼe">parent</span><span> </span><span class="ͼ8">=</span><span> </span><span class="ͼe">node</span><span class="ͼ8">.</span><span>parentElement;</span><br><br><span>    </span><span class="ͼ6">// ❌ skip unwanted tags</span><br><span>    </span><span class="ͼ8">if</span><span> (</span><span class="ͼ8">!</span><span class="ͼe">parent</span><span> </span><span class="ͼ8">||</span><span> [</span><span class="ͼc">"SCRIPT"</span><span>, </span><span class="ͼc">"STYLE"</span><span>, </span><span class="ͼc">"INPUT"</span><span>, </span><span class="ͼc">"TEXTAREA"</span><span>]</span><span class="ͼ8">.</span><span>includes(</span><span class="ͼe">parent</span><span class="ͼ8">.</span><span>tagName)) {</span><br><span>      </span><span class="ͼ8">continue</span><span>;</span><br><span>    }</span><br><br><span>    </span><span class="ͼ8">if</span><span> (</span><span class="ͼ8">!</span><span class="ͼe">regex</span><span class="ͼ8">.</span><span>test(</span><span class="ͼe">node</span><span class="ͼ8">.</span><span>nodeValue)) </span><span class="ͼ8">continue</span><span>;</span><br><br><span>    </span><span class="ͼ6">// ✅ create fragment instead of replacing whole node</span><br><span>    </span><span class="ͼ8">const</span><span> </span><span class="ͼe">fragment</span><span> </span><span class="ͼ8">=</span><span> </span><span class="ͼe">document</span><span class="ͼ8">.</span><span>createDocumentFragment();</span><br><span>    </span><span class="ͼ8">let</span><span> </span><span class="ͼe">lastIndex</span><span> </span><span class="ͼ8">=</span><span> </span><span class="ͼb">0</span><span>;</span><br><br><span>    </span><span class="ͼe">node</span><span class="ͼ8">.</span><span>nodeValue</span><span class="ͼ8">.</span><span>replace(</span><span class="ͼe">regex</span><span>, (</span><span class="ͼe">match</span><span>, </span><span class="ͼe">index</span><span>) =&gt; {</span><br><span>      </span><span class="ͼ6">// normal text</span><br><span>      </span><span class="ͼe">fragment</span><span class="ͼ8">.</span><span>appendChild(</span><span class="ͼe">document</span><span class="ͼ8">.</span><span>createTextNode(</span><span class="ͼe">node</span><span class="ͼ8">.</span><span>nodeValue</span><span class="ͼ8">.</span><span>slice(</span><span class="ͼe">lastIndex</span><span>, </span><span class="ͼe">index</span><span>)));</span><br><br><span>      </span><span class="ͼ6">// highlighted text</span><br><span>      </span><span class="ͼ8">const</span><span> </span><span class="ͼe">mark</span><span> </span><span class="ͼ8">=</span><span> </span><span class="ͼe">document</span><span class="ͼ8">.</span><span>createElement(</span><span class="ͼc">"span"</span><span>);</span><br><span>      </span><span class="ͼe">mark</span><span class="ͼ8">.</span><span>className </span><span class="ͼ8">=</span><span> </span><span class="ͼc">"custom-highlight"</span><span>;</span><br><span>      </span><span class="ͼe">mark</span><span class="ͼ8">.</span><span>textContent </span><span class="ͼ8">=</span><span> </span><span class="ͼe">match</span><span>;</span><br><span>      </span><span class="ͼe">fragment</span><span class="ͼ8">.</span><span>appendChild(</span><span class="ͼe">mark</span><span>);</span><br><br><span>      </span><span class="ͼe">lastIndex</span><span> </span><span class="ͼ8">=</span><span> </span><span class="ͼe">index</span><span> </span><span class="ͼ8">+</span><span> </span><span class="ͼe">match</span><span class="ͼ8">.</span><span>length;</span><br><span>    });</span><br><br><span>    </span><span class="ͼ6">// remaining text</span><br><span>    </span><span class="ͼe">fragment</span><span class="ͼ8">.</span><span>appendChild(</span><span class="ͼe">document</span><span class="ͼ8">.</span><span>createTextNode(</span><span class="ͼe">node</span><span class="ͼ8">.</span><span>nodeValue</span><span class="ͼ8">.</span><span>slice(</span><span class="ͼe">lastIndex</span><span>)));</span><br><br><span>    </span><span class="ͼe">node</span><span class="ͼ8">.</span><span>parentNode</span><span class="ͼ8">.</span><span>replaceChild(</span><span class="ͼe">fragment</span><span>, </span><span class="ͼe">node</span><span>);</span><br><span>  }</span><br><span>});</span></div></div></div></div></div></div></div></div></div><div class=""><div class="" style="width: 100%; transform: none;"></div></div></div></div></div></pre>
