editEmployee(id: number) {
   this.ser.getEmpById(id).subscribe((res) =&gt; {
    // Use the entire employee object or just the data needed
    this.mydata=res.body
    if(this.mydata){
      this.store.dispatch(new SetActionData(this.mydata));
        this.route.navigate(['/employeeform'], );//  data vacina tarvta we are navigating to empForm
    }
  });
}

