	==realtime example of fork join===
	import { forkJoin } from 'rxjs';
	
	  forkJoin({
       historySer:this.historyService.addObstetricalHistory(forms),
       obsservice:this.patientService.getPageAction(this.userId).pipe(takeUntil(this.onDestroy$))
       }).subscribe({
      next:(res)=&gt;{
